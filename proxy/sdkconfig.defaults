CONFIG_IDF_TARGET="esp32"

# The desk hangs off UART2, as the carrier board in pcb/ wires it: GPIO17 (TX2)
# to RJ45 pin 5, where the box listens, GPIO16 (RX2) from the divider off pin 6,
# where it sends, and wake on 23. Wired by hand with the pins the other way
# round, swap TX and RX; the wrong way looks exactly like a dead control box.
CONFIG_LOCTEK_UART_NUM=2
CONFIG_LOCTEK_TX_GPIO=17
CONFIG_LOCTEK_RX_GPIO=16
CONFIG_LOCTEK_WAKE_GPIO=23

# Indicator LEDs inside the RJ45 jack, driven through R5/R6 (220R).
CONFIG_PROXY_LED_BT_GPIO=32
CONFIG_PROXY_LED_DESK_GPIO=33
CONFIG_PROXY_LED_SELFTEST=y

# Nothing here draws a screen, so the console can stay on UART0.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000

# BLE peripheral: the link the panel drives the desk over, and updates arrive by.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="desk-companion"

# Live. Set this to y to have every command decoded and accounted for, the
# deadman included, with only the frames that would move the desk held back.
CONFIG_LOCTEK_PROXY_DRY_RUN=n

# NimBLE narrates every notification, which at five a second buries everything
# else on the console and costs more than the notification does.
CONFIG_BT_NIMBLE_LOG_LEVEL_NONE=y

# Two app slots, so the panel can send a new firmware over the link; see
# partitions.csv. A firmware booted from an update that does not reach the
# panel restarts, and the bootloader then returns to the one before.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
