CONFIG_IDF_TARGET="esp32"

# The desk hangs off UART2 on this board, wake on 23. TX and RX are the way
# round the wiring actually is rather than the way round the table said: with
# them the other way the box heard nothing and answered nothing, and with them
# like this it decodes frames and reports its height.
CONFIG_LOCTEK_UART_NUM=2
CONFIG_LOCTEK_TX_GPIO=16
CONFIG_LOCTEK_RX_GPIO=17
CONFIG_LOCTEK_WAKE_GPIO=23

# Nothing here draws a screen, so the console can stay on UART0.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000

# BLE peripheral, for the link to the panel. Echo only for now: this build
# measures the path, it does not drive anything over it.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="desk-proxy"

# Live. Set this to y to have every command decoded and accounted for, the
# deadman included, with only the frames that would move the desk held back.
CONFIG_LOCTEK_PROXY_DRY_RUN=n

# NimBLE narrates every notification, which at five a second buries everything
# else on the console and costs more than the notification does.
CONFIG_BT_NIMBLE_LOG_LEVEL_NONE=y
