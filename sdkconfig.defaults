CONFIG_IDF_TARGET="esp32p4"

# ESP32-P4 rev <3.0 and >=3.0 are separate build targets; IDF defaults to
# >=v3.1 while early Tab5 units carry a v1.x die. Check with `esptool.py chip_id`.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# Flash / partitions (Tab5 has 16 MB)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# 4 MB for the app and a SPIFFS partition, out of the board's 16 MB. The
# default 1.5 MB leaves no room once MQTT and TLS are linked in.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM (Tab5 has 32 MB, hex mode). LVGL draw buffers for 720x1280 do not fit
# in internal RAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

CONFIG_FREERTOS_HZ=1000

# Console over USB Serial/JTAG, which frees UART0 (GPIO37/38, M5-Bus pins
# 14/13) for the desk control box. Flashing and idf.py monitor still work over
# the USB-C port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# LVGL
CONFIG_LV_COLOR_DEPTH_16=y

# The P4's Pixel Processing Accelerator does rotation, fills, blends and
# transforms instead of the CPU. It reaches draw buffers through the cache, so
# LVGL's buffer alignment must equal the 64 B data cache line size.
CONFIG_LVGL_PORT_ENABLE_PPA=y
CONFIG_LV_USE_PPA=y
CONFIG_LV_USE_PPA_IMG=y
CONFIG_LV_DRAW_BUF_ALIGN=64

# Draw buffer height in lines. Double buffering plus PPA rotation allocates
# three buffers of 720 x N x 2 bytes in internal RAM, so this cannot go much
# above 50 before startup allocation fails.
CONFIG_BSP_LCD_DRAW_BUF_HEIGHT=50

# On-screen FPS / memory overlay. LV_USE_SYSMON gates the two below it.
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LV_USE_MEM_MONITOR=y
# Tints redrawn regions; the fastest way to spot wasted full-screen
# invalidation when hunting dropped frames.
# CONFIG_LV_USE_REFR_DEBUG=y

# Fonts used by components/ui (only _14 is built in by default).
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# --- Wi-Fi via the ESP32-C6 co-processor -------------------------------------
# The P4 has no radio. esp_hosted carries the Wi-Fi API to the C6 over SDIO;
# the C6 runs its own slave firmware, flashed separately over its own port.
CONFIG_ESP_HOSTED_ENABLED=y
# The slave target is derived from this choice, not set directly.
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=4
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=13
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=12
CONFIG_ESP_HOSTED_SDIO_PIN_D0=11
# In 4-bit mode D1 comes from the _PRIV_ symbol; setting only SDIO_PIN_D1
# leaves it at the default 15, which collides with the slave reset line.
CONFIG_ESP_HOSTED_SDIO_PIN_D1=10
CONFIG_ESP_HOSTED_SDIO_PRIV_PIN_D1_4BIT_BUS=10
CONFIG_ESP_HOSTED_PRIV_SDIO_OPTION=y
CONFIG_ESP_HOSTED_SDIO_PIN_D2=9
CONFIG_ESP_HOSTED_SDIO_PIN_D3=8
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15
CONFIG_ESP_HOSTED_RESET_GPIO_ACTIVE_LOW=y
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y

# Lets a DHCP-offered NTP server win over pool.ntp.org, which esp_netif_sntp
# refuses to configure without this.
CONFIG_LWIP_DHCP_GET_NTP_SRV=y

# --- MQTT --------------------------------------------------------------------
# Plain mqtt:// on the LAN, so neither transport is needed.
#
# These save far less than it first appears. mbedTLS is linked regardless:
# esp-mqtt calls esp_tls_get_and_clear_last_error() unconditionally, which
# pulls in esp_tls.c, whose read dispatch references esp_mbedtls_read, which
# drags in the TLS engine -- about 165 KB that turning this off does not
# remove. What it actually saves is the transport registration, a couple of
# kilobytes. The websocket transport is the larger of the two.
CONFIG_MQTT_TRANSPORT_SSL=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n

# LVGL's own allocator is a fixed 64 KB pool that cannot grow, and every object,
# style, label buffer and draw mask comes out of it. A NULL from lv_malloc is not
# reported -- the radius mask dereferences it and the panic lands in the drawing
# code, far from the real cause. Hand LVGL the system heap instead, which has the
# board's PSRAM behind it.
# LVGL allocates through components/ui/lv_mem_psram.c, in PSRAM.
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
# Rounded corners are cached per distinct radius, and the screen now uses about
# ten. At the default of 4 every frame evicted and re-allocated the rest.
CONFIG_LV_DRAW_SW_CIRCLE_CACHE_SIZE=16

# LVGL renders in software on a dual-core chip, and by default it uses one core.
# A page change is one large frame -- the whole content area at once -- so that
# frame is where the cost lands. Two draw units split it across both cores.
# Needs an OS abstraction: with LV_OS_NONE the draw-unit count is ignored.
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_DRAW_THREAD_PRIO=3

# 33 ms is 30 Hz, which gave a 180 ms animation about five frames to work with --
# that reads as steps, not motion. The panel runs at 60, and with the render
# split across both cores small invalidations are cheap, so match it.
CONFIG_LV_DEF_REFR_PERIOD=16

# The P4 has no radio of its own: NimBLE runs here and the controller lives on
# the C6, reached over the same SDIO link Wi-Fi uses. Observer role only --
# the panel listens for advertisements and never connects to anything.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# Defaults to y whenever the controller is disabled, which both hides the hosted
# option below and leaves the VHCI transport uncompiled -- the link then fails on
# ble_transport_to_hs_acl_impl. Our controller is on the C6, not a UART.
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
# Scanning only needs the observer role, but hosted's VHCI driver references
# ble_transport_to_hs_acl_impl unconditionally, and NimBLE only compiles that
# when a connecting role is enabled. Central costs some flash we do not use.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y

# app_main builds the whole LVGL object tree before handing off, and the
# default is not sized for that.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# The NimBLE host runs our advertisement callback, which does an AES pass and
# can log a presence transition, underneath its own HCI frames.
# NimBLE narrates every read and write, which at five a second is most of what
# the log ring holds and most of what the diagnostics page shows.
CONFIG_BT_NIMBLE_LOG_LEVEL_NONE=y
# Raised when this task was feeding the log ring on every packet it narrated.
# It narrates nothing now and measures 2.4 KB used.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144

# The Bluetooth transport to the other chip allocates DMA-capable memory to
# send, and so does the AES that TLS runs on. What failed was not a Bluetooth
# pool but internal memory that can be reached by DMA -- enlarging those pools
# would have consumed more of exactly what had run out. The two settings below
# are the actual fix.

# mbedtls holds a sixteen kilobyte input buffer for the whole life of a
# connection. This frees the large buffers between records instead, which is
# what it is for.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# Anything smaller than this stays in internal memory even though it does not
# need to be there. At sixteen kilobytes that included mbedtls's buffers and a
# great deal else, crowding out the allocations that genuinely must be internal
# because something DMAs from them.
# Below this size an allocation is kept in internal RAM. On this part
# "internal" is three pools and only one of them, L2MEM, is reachable by DMA;
# SPM and RTCRAM are not. So the free-internal figure can look comfortable while
# the only pool the Wi-Fi transport, AES and TLS can draw from is empty -- 43 KB
# internal against 4 KB DMA-capable, and the SDIO driver asserting for want of a
# receive buffer. LVGL allocates every widget through plain malloc and none of
# them need DMA, so sending them to PSRAM hands L2MEM back to the drivers that
# do. Measured at rest: 23 KB dma-capable low-water at 128, 87 KB at this, and
# the radar redraw went from 85 to 80 us an aircraft rather than slower.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=64

# LVGL's on-screen monitors rewrite a label every refresh period, so the
# rendering pipeline never reaches an idle frame and task_max_sleep_ms can
# never take effect. On a wall panel whose content changes once a minute that
# is continuous CPU and power for two debug labels.
CONFIG_LV_USE_SYSMON=n
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_USE_MEM_MONITOR=n

# Two of these, using 1.5 KB of the eight they had. Trimmed less hard than
# the rest: what a draw thread needs depends on what is being drawn, and an
# overflow there is a hard crash.
CONFIG_LV_DRAW_THREAD_STACK_SIZE=5120

# The flash is read four bits at a time rather than two. Verified booting on
# this board: the second-stage bootloader reports SPI Mode : QIO. Note that
# esptool still writes the image with --flash_mode dio and that is correct --
# IDF maps the QIO choice to the string "dio" on purpose, because the ROM has to
# be able to read the bootloader before anything has configured quad mode.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# Debug lines are compiled in but off at runtime, so a chatty subsystem can be
# turned up with esp_log_level_set() without a reflash.
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# Lets the panel hand back a picture of its own screen over the console, so a
# layout can be looked at rather than guessed at. See tools/screenshot.py.
CONFIG_LV_USE_SNAPSHOT=y

# Software AES: the hardware engine copies each chunk into fresh internal DMA
# memory, and with that pool this tight Outlook's downloads failed halfway.
# CONFIG_MBEDTLS_HARDWARE_AES is not set
# Without DMA, TLS needs no internal memory; a large download took it to 1 KB.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# MQTT, the socket, four radar feeds, calendar, travel and cover art can all be
# open at once, which is nine of the default ten.
CONFIG_LWIP_MAX_SOCKETS=16
