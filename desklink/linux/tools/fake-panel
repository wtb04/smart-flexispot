#!/usr/bin/env python3
"""A stand-in panel on this laptop: answers Desk Link's states as the panel does,
pings it back, and sends it commands typed here.

    tools/fake-panel 8080            then point Desk Link's address at 127.0.0.1:8080
    > pause | play | next | previous | seek 30 | volume 40 | mute on | cover | quit
"""

import http.server
import json
import os
import sys
import threading
import urllib.request

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
from desklink import seal  # noqa: E402

KEY = bytes.fromhex(os.environ.get("DESKLINK_KEY", "00" * 32))
envelope = seal.Envelope(KEY)
laptop = {"url": None, "art": ""}
lock = threading.Lock()


def to_laptop(path, message):
    if not laptop["url"]:
        print("no laptop yet")
        return None
    request = urllib.request.Request(laptop["url"] + path, data=envelope.sealed(message, path), method="POST")
    try:
        with urllib.request.urlopen(request, timeout=2) as answer:
            body = answer.read()
    except OSError as error:
        print("laptop:", error)
        return None
    if path == "/cover":
        return seal.open_(KEY, "/cover reply", body)[0]
    with lock:
        return envelope.opened(body, path + " reply")


class Panel(http.server.BaseHTTPRequestHandler):
    def do_POST(self):
        body = self.rfile.read(int(self.headers.get("Content-Length", 0)))
        with lock:
            message = envelope.opened(body, "/link")
        if message is None:
            self.send_response(403)
            self.end_headers()
            return
        if message["type"] == "state":
            laptop["url"] = f"http://{self.client_address[0]}:{message['port']}"
            laptop["art"] = message.get("art", "")
            print("state:", {k: v for k, v in message.items() if k not in ("type", "at")})
        else:
            print(message["type"] + ":", message.get("event", message))
        reaches = to_laptop("/link", {"type": "ping"}) is not None if message["type"] == "state" else None
        pong = {"type": "pong", "panel": "fake-panel", "firmware": "fake"}
        if reaches is not None:
            pong["reaches"] = reaches
        with lock:
            answer = envelope.sealed(pong, "/link reply")
        self.send_response(200)
        self.send_header("Content-Length", str(len(answer)))
        self.end_headers()
        self.wfile.write(answer)

    def log_message(self, *_):
        pass


def commands():
    for line in sys.stdin:
        words = line.split()
        if not words:
            continue
        if words[0] == "quit":
            os._exit(0)
        if words[0] == "cover":
            jpeg = to_laptop("/cover", {"type": "cover", "art": laptop["art"]})
            print("cover:", len(jpeg) if jpeg else None, "bytes")
            continue
        message = {"type": "command", "command": words[0]}
        if words[0] == "seek":
            message["position"] = float(words[1])
        elif words[0] == "volume":
            message["level"] = int(words[1])
        elif words[0] == "mute":
            message["muted"] = words[1:] == ["on"]
        print("answer:", to_laptop("/link", message))


if __name__ == "__main__":
    port = int(sys.argv[1]) if len(sys.argv) > 1 else 8080
    threading.Thread(target=commands, daemon=True).start()
    print(f"fake panel on :{port}")
    http.server.ThreadingHTTPServer(("0.0.0.0", port), Panel).serve_forever()
